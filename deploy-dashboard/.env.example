WKE_PRODUCTION_ORIGIN=https://weknowenglish.online
WKE_PREVIEW_ORIGIN=https://preview.weknowenglish.online
WKE_DASHBOARD_GIT_COMMIT_SHA=development
WKE_DASHBOARD_ORIGIN=http://localhost:3000

# Temporary legacy administrator session. Remove these after GitHub sign-in is verified.
WKE_DASHBOARD_ADMIN_PASSWORD=replace-with-a-long-unique-password
WKE_DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
WKE_DASHBOARD_BREAK_GLASS_ENABLED=false

# Individual administrator identities. Use a dedicated control-plane Supabase project,
# never the WKE student/teacher data project.
WKE_DASHBOARD_GITHUB_CLIENT_ID=
WKE_DASHBOARD_GITHUB_CLIENT_SECRET=
WKE_DASHBOARD_GITHUB_ROLE_MAP={"YourGitHubLogin":"owner"}
WKE_DASHBOARD_REQUIRE_GITHUB_2FA=true
CONTROL_PLANE_SUPABASE_URL=
CONTROL_PLANE_SUPABASE_SERVICE_ROLE_KEY=
CONTROL_PLANE_ORGANIZATION_ID=
CONTROL_PLANE_PROJECT_ID=

# Fail closed by default: production needs a different owner/administrator to approve.
# Enable only while an organization has exactly one administrator; every use is audited.
WKE_DEPLOY_SINGLE_ADMIN_BREAK_GLASS=false
WKE_DEPLOY_WORKER_SECRET=

# 32 random bytes encoded as base64. Retain previous versions securely until stored
# credentials have been re-encrypted with the new version.
CONTROL_PLANE_MASTER_KEY=
CONTROL_PLANE_MASTER_KEY_VERSION=1

# Optional shared login throttling (recommended in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Managed Hostinger control plane (server-side only)
HOSTINGER_API_TOKEN=
WKE_HOSTINGER_USERNAME=u389919369
WKE_HOSTINGER_GIT_INSTALLATION_UUID=01a0d67f-b259-734d-90e8-a0e7337a2e3a
WKE_PRODUCTION_DOMAIN=weknowenglish.online
WKE_PREVIEW_DOMAIN=preview.weknowenglish.online
WKE_DASHBOARD_PRODUCTION_BRANCH=main
WKE_DASHBOARD_PREVIEW_BRANCH=main

# Preferred: GitHub App installed only on approved repositories. Installation tokens expire.
WKE_GITHUB_APP_ID=
WKE_GITHUB_APP_PRIVATE_KEY=
WKE_GITHUB_APP_INSTALLATION_ID=

# Temporary fallback: fine-grained token with Contents read/write for this repository only.
GITHUB_DEPLOY_TOKEN=
WKE_GITHUB_OWNER=WeKnowEnglish
WKE_GITHUB_REPOSITORY=WKE-AuthoringTool-Elearning-Player
