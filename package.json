{
  "name": "wke-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "build": "cross-env WKE_MANAGED_HOSTING=true npm run build:managed --workspace=web",
    "start": "cross-env WKE_MANAGED_HOSTING=true node web/dist/server.js",
    "test:hostinger:production": "npm run test:hostinger:production --workspace=web",
    "test:hostinger:release-controller": "npm run test:hostinger:release-controller --workspace=web",
    "wait:hostinger:release": "npm run wait:hostinger:release --workspace=web"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
