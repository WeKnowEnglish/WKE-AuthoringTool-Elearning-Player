# Copy to .env.local (never commit .env.local)

# --- Server & middleware (recommended: no NEXT_PUBLIC_ prefix) ---
# Same values as below; used by Server Components + middleware so they are not
# pulled in as public env unless needed elsewhere.
SUPABASE_URL=https://vmqvhzghfbwcfnxittta.supabase.co
SUPABASE_ANON_KEY=

# --- Browser (required for /teacher login) ---
NEXT_PUBLIC_SUPABASE_URL=https://vmqvhzghfbwcfnxittta.supabase.co
# Legacy JWT anon OR new publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Virtual Classroom Supabase Realtime shadow pilot. Keep false/omitted until
# Realtime private-channel access is enabled and migration 128 is applied.
NEXT_PUBLIC_CLASSROOM_REALTIME_SHADOW_MODE=false
# First visible Supabase cutover. Requires the shadow flag above. This currently
# switches only the low-risk classroom announcement display.
NEXT_PUBLIC_CLASSROOM_REALTIME_ANNOUNCEMENT_PILOT=false
# Second visible Supabase cutover. Requires the shadow flag above; switches
# only the teacher's shared student-pen permission in Learn mode.
NEXT_PUBLIC_CLASSROOM_REALTIME_LEARN_PENS_PILOT=false
# Third visible Supabase cutover. Requires shadow mode and switches the shared
# Learn navigation as one unit: meeting/learn, whiteboard/activity/presentation,
# selected activity, shared presentation resource, and synchronized PDF page.
NEXT_PUBLIC_CLASSROOM_REALTIME_LEARN_NAVIGATION_PILOT=false
# First visible Supabase Presence cutover. Requires shadow mode; switches only
# the Attendance panel's in-classroom roster, not picker/group tool inputs.
NEXT_PUBLIC_CLASSROOM_REALTIME_PRESENCE_ROSTER_PILOT=false
# Teacher picker/group roster from durable active attendance. Requires shadow
# mode and falls back to Liveblocks until at least one active student is known.
NEXT_PUBLIC_CLASSROOM_REALTIME_PARTICIPANT_REGISTRY_PILOT=false
# Shared countdown/stopwatch state from Supabase snapshot + Broadcast. The
# timer still ticks locally and Liveblocks remains the write/fallback path.
NEXT_PUBLIC_CLASSROOM_REALTIME_TIMER_PILOT=false
# Shared dice/randomiser configuration and results from snapshot + Broadcast.
NEXT_PUBLIC_CLASSROOM_REALTIME_RANDOMISER_PILOT=false
# Session points totals, award history, and leaderboard visibility.
NEXT_PUBLIC_CLASSROOM_REALTIME_POINTS_PILOT=false
# Student picker, selection history, and group-maker state as one roster unit.
NEXT_PUBLIC_CLASSROOM_REALTIME_PICKER_GROUPS_PILOT=false
# Student ready/help/hand/finished status plus teacher interaction freeze.
NEXT_PUBLIC_CLASSROOM_REALTIME_STATUS_PILOT=false
# Session ended state and the currently launched shared activity.
NEXT_PUBLIC_CLASSROOM_REALTIME_LIFECYCLE_PILOT=false
# Server-only first authority pilot. Keep false until the announcement, Learn
# navigation, and Learn pens read pilots above are all enabled and verified.
# Supabase commits those shared controls first; Liveblocks remains a mirror.
CLASSROOM_REALTIME_SUPABASE_AUTHORITY_PILOT=false
# Server-only authority for timer, dice, points, picker/groups, and student
# status. Requires every matching read pilot and participant registry above.
CLASSROOM_REALTIME_SUPABASE_TOOL_AUTHORITY_PILOT=false
# Server-only authority for active collaborative-room references and class end.
# Nested collaboration remains on Liveblocks. Requires lifecycle read pilot.
CLASSROOM_REALTIME_SUPABASE_LIFECYCLE_AUTHORITY_PILOT=false
# Public shell cutover for class-linked sessions only. Requires every visible
# read pilot plus all three server authority flags above. The authenticated
# runtime endpoint confirms server readiness before removing the compatibility
# room. Guest shell excluded. NEXT_PUBLIC changes require a new deployment.
NEXT_PUBLIC_CLASSROOM_REALTIME_NATIVE_SHELL_PILOT=false

# --- Server-only (never NEXT_PUBLIC_) ---
GEMINI_API_KEY=
# Default in code is gemini-2.5-flash; override if your project uses another id:
# GEMINI_MODEL=gemini-2.5-flash

# Server-only — student speech transcription and authored character voice audio.
# Never use a NEXT_PUBLIC_ prefix or commit the real key.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Server-only — required for `npm run create-teacher` and student account creation on /login
# (never expose to client or NEXT_PUBLIC_). Optional: media library reads on /teststartpage.
# Required by live-game challenge persistence, teacher tooling, and student account creation.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only — platform admins (lexicon approval, etc.). Teachers are not admins.
# Prefer Auth app_metadata.admin=true. Optional email override:
# ADMIN_EMAILS=bradydmyers@gmail.com

# Server-only — teacher access requests and administrator email notifications.
# Apply migration 032_teacher_access_requests.sql before enabling the request form.
# RESEND_API_KEY=re_...
# TEACHER_ACCESS_NOTIFICATION_EMAIL=admin@example.com
# Optional verified sender. Resend's onboarding sender is used when omitted.
# TEACHER_ACCESS_FROM_EMAIL=We Know English <teachers@example.com>
# Public site origin used in welcome-email login links and auth email redirects
# (parent signup confirm, password reset). No trailing slash.
# On Vercel production set this to https://weknowenglish.online so preview
# deployments never poison confirmation emails.
# APP_ORIGIN=https://weknowenglish.online
# NEXT_PUBLIC_APP_ORIGIN=https://weknowenglish.online

# Dev — EDU Studio → Lesson Player CORS (pack inbox + POST /api/studio/assets).
# STUDIO_ORIGIN=http://localhost:3001
# NEXT_PUBLIC_STUDIO_ORIGIN=http://localhost:3001

# Server-only — Liveblocks multiplayer board game auth
# LIVEBLOCKS_SECRET_KEY=

# Server-only — Daily.co Virtual Classroom video (Phase 1+)
# DAILY_API_KEY=
# Optional domain host shown to clients (no secret), e.g. your-subdomain.daily.co
# DAILY_DOMAIN=
# NEXT_PUBLIC_DAILY_DOMAIN=
# Gate: unset + key present enables locally; set 0/false to force off
# DAILY_ENABLED=
# Base64 HMAC secret from Daily webhook create (or supply your own when registering).
# Endpoint: POST /api/webhooks/daily  (participant.* + transcript.* + recording.*)
# DAILY_WEBHOOK_HMAC=

# Server-only — HMAC for Virtual Classroom host/member cookies (Phase 3c).
# Falls back to LIVEBLOCKS_SECRET_KEY, then a local dev default (not for production).
# VIRTUAL_CLASSROOM_COOKIE_SECRET=

# Optional shared rate limits across serverless instances (Phase 3c).
# When unset, Daily routes use in-memory limits per instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cron auth for POST/GET /api/cron/daily-cleanup (expired Daily rooms + webhook prune).
# Authorization: Bearer <CRON_SECRET>  or  x-cron-secret: <CRON_SECRET>
# CRON_SECRET=

# --- Story unified dispatcher (Stage 0 scaffold; wired in Stage 3) ---
# When unset or 0/false: legacy StoryBookView paths only (default).
# Set to 1 or true to route reactions through web/lib/story-unified (in progress).
# Docs: web/lib/story-unified/README.md
# NEXT_PUBLIC_STORY_UNIFIED_DISPATCH=

# NEXT_PUBLIC_STORY_UNIFIED_DISPATCH=
