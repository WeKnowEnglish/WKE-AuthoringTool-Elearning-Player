    { "id": "p5-zara", "kind": "speech", "text": "I'll bring water.", "speakerId": "zara", "bounds": { "x": 24, "y": 60, "width": 19, "height": 4.2 }, "tail": { "side": "bottom", "offset": 50 }, "readOrder": 10, "fontScale": 0.58, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p5-ethan", "kind": "speech", "text": "We have to help him. I'll help carry him.", "speakerId": "ethan", "bounds": { "x": 45, "y": 60, "width": 25, "height": 4.5 }, "tail": { "side": "bottom", "offset": 53 }, "readOrder": 11, "fontScale": 0.52, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p5-leo", "kind": "speech", "text": "I'll get a blanket.", "speakerId": "leo", "bounds": { "x": 73, "y": 60, "width": 24, "height": 4.2 }, "tail": { "side": "bottom", "offset": 50 }, "readOrder": 12, "fontScale": 0.58, "vocabularyIds": ["blanket"], "emphasis": "normal" },

