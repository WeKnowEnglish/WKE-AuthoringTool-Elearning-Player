    { "id": "p4-mia", "kind": "speech", "text": "You're weak.", "speakerId": "mia", "bounds": { "x": 66, "y": 52, "width": 15, "height": 4.8 }, "tail": { "side": "left", "offset": 48 }, "readOrder": 7, "fontScale": 0.7, "vocabularyIds": ["weak"], "emphasis": "normal" },
    { "id": "p4-keelan-after", "kind": "speech", "text": "I'll be all right.", "speakerId": "keelan", "bounds": { "x": 5, "y": 52, "width": 17, "height": 6 }, "tail": { "side": "left", "offset": 50 }, "readOrder": 8, "fontScale": 0.82, "vocabularyIds": [], "emphasis": "normal" },

