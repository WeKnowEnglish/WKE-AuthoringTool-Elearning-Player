    { "id": "p3-zara", "kind": "speech", "text": "It's beautiful!", "speakerId": "zara", "bounds": { "x": 45, "y": 26.2, "width": 18, "height": 4.8 }, "tail": { "side": "bottom", "offset": 45 }, "readOrder": 4, "fontScale": 0.68, "vocabularyIds": [], "emphasis": "shout" },
    { "id": "p3-leo", "kind": "speech", "text": "You're a real alien!", "speakerId": "leo", "bounds": { "x": 79, "y": 26.2, "width": 18, "height": 4.8 }, "tail": { "side": "bottom", "offset": 55 }, "readOrder": 5, "fontScale": 0.66, "vocabularyIds": [], "emphasis": "shout" },

