    { "id": "p1-ethan", "kind": "speech", "text": "Are you really from another planet?", "speakerId": "ethan", "bounds": { "x": 38, "y": 1, "width": 22, "height": 5.5 }, "tail": { "side": "bottom", "offset": 52 }, "readOrder": 1, "fontScale": 0.65, "vocabularyIds": ["planet"], "emphasis": "normal" },
