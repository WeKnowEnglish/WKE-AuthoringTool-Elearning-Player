  "altText": "Mia leaves Keelan safely with Grandpa Minh nearby. The next morning the four friends find Keelan gone and follow faint four-toed traces toward the hills.",
  "elements": [
    { "id": "p1-number", "kind": "panel_number", "text": "1", "bounds": { "x": 1, "y": 1, "width": 5, "height": 4 }, "fontScale": 1, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p1-mia", "kind": "speech", "text": "Try to sleep. We'll be back before school.", "speakerId": "mia", "bounds": { "x": 34, "y": 1, "width": 25, "height": 5.5 }, "tail": { "side": "bottom", "offset": 52 }, "readOrder": 1, "fontScale": 0.62, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p1-keelan", "kind": "speech", "text": "Good night, Mia.", "speakerId": "keelan", "bounds": { "x": 69, "y": 1, "width": 18, "height": 5 }, "tail": { "side": "bottom", "offset": 48 }, "readOrder": 2, "fontScale": 0.68, "vocabularyIds": [], "emphasis": "normal" },

    { "id": "p2-number", "kind": "panel_number", "text": "2", "bounds": { "x": 1, "y": 26, "width": 5, "height": 4 }, "fontScale": 1, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p2-narration", "kind": "narration", "text": "The next morning, they returned before school.", "speakerId": "narrator", "bounds": { "x": 7, "y": 26.1, "width": 27, "height": 5 }, "readOrder": 3, "fontScale": 0.64, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p2-zara", "kind": "speech", "text": "I hope he's feeling better.", "speakerId": "zara", "bounds": { "x": 36, "y": 26.1, "width": 22, "height": 5 }, "tail": { "side": "bottom", "offset": 45 }, "readOrder": 4, "fontScale": 0.64, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p2-leo", "kind": "speech", "text": "Keelan? We brought breakfast!", "speakerId": "leo", "bounds": { "x": 72, "y": 26.1, "width": 24, "height": 5.5 }, "tail": { "side": "bottom", "offset": 50 }, "readOrder": 5, "fontScale": 0.64, "vocabularyIds": [], "emphasis": "shout" },

    { "id": "p3-number", "kind": "panel_number", "text": "3", "bounds": { "x": 1, "y": 46, "width": 5, "height": 4 }, "fontScale": 1, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p3-ethan", "kind": "speech", "text": "He's gone!", "speakerId": "ethan", "bounds": { "x": 6, "y": 47, "width": 16, "height": 6 }, "tail": { "side": "bottom", "offset": 50 }, "readOrder": 6, "fontScale": 0.9, "vocabularyIds": [], "emphasis": "shout" },
    { "id": "p3-mia", "kind": "speech", "text": "But where did he go?", "speakerId": "mia", "bounds": { "x": 74, "y": 47, "width": 21, "height": 7 }, "tail": { "side": "bottom", "offset": 48 }, "readOrder": 7, "fontScale": 0.82, "vocabularyIds": [], "emphasis": "normal" },

    { "id": "p4-number", "kind": "panel_number", "text": "4", "bounds": { "x": 1, "y": 61, "width": 5, "height": 4 }, "fontScale": 1, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p4-mia", "kind": "speech", "text": "He left in a hurry.", "speakerId": "mia", "bounds": { "x": 5, "y": 61.3, "width": 20, "height": 5.5 }, "tail": { "side": "bottom", "offset": 40 }, "readOrder": 8, "fontScale": 0.68, "vocabularyIds": ["hurry"], "emphasis": "normal" },

    { "id": "p5-number", "kind": "panel_number", "text": "5", "bounds": { "x": 50, "y": 61, "width": 5, "height": 4 }, "fontScale": 1, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p5-zara", "kind": "speech", "text": "Look! There's a trail.", "speakerId": "zara", "bounds": { "x": 53, "y": 61.3, "width": 20, "height": 5.5 }, "tail": { "side": "bottom", "offset": 38 }, "readOrder": 9, "fontScale": 0.66, "vocabularyIds": ["trail"], "emphasis": "shout" },
    { "id": "p5-leo", "kind": "speech", "text": "It leads toward the hills.", "speakerId": "leo", "bounds": { "x": 76, "y": 61.3, "width": 21, "height": 5.5 }, "tail": { "side": "bottom", "offset": 50 }, "readOrder": 10, "fontScale": 0.64, "vocabularyIds": ["hills"], "emphasis": "normal" },

    { "id": "p6-number", "kind": "panel_number", "text": "6", "bounds": { "x": 1, "y": 79, "width": 5, "height": 4 }, "fontScale": 1, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p6-mia", "kind": "speech", "text": "He went to find others like him.", "speakerId": "mia", "bounds": { "x": 24, "y": 81, "width": 25, "height": 8 }, "tail": { "side": "bottom", "offset": 48 }, "readOrder": 11, "fontScale": 0.76, "vocabularyIds": [], "emphasis": "normal" },
    { "id": "p6-zara", "kind": "speech", "text": "Then we have to find him.", "speakerId": "zara", "bounds": { "x": 57, "y": 81, "width": 24, "height": 8 }, "tail": { "side": "bottom", "offset": 52 }, "readOrder": 12, "fontScale": 0.78, "vocabularyIds": [], "emphasis": "normal" },
