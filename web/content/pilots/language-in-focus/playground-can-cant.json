    "general": {
      "title": "Ability sentences",
      "body": "We use **can** and **can't** to say what someone is able to do.",
      "items": [
        {
          "id": "g-who",
          "text": "Who",
          "note": "I / She / He",
          "icon": "me"
        },
        {
          "id": "g-can",
          "text": "Can",
          "note": "can / can't",
          "icon": "heart"
        },
        {
          "id": "g-do",
          "text": "Action",
          "note": "swim, jump…",
          "icon": "ball"
        }
      ]
    },
    "intro": "Tap a word in the sentence to see the grammar tip.",
    "focus_panels": [
      {
        "role": "subject",
        "title": "People words",
        "body": "These words tell us **who** we are talking about.",
        "items": [
          {
            "id": "p-i",
            "text": "I",
            "note": "me",
            "icon": "me"
          },
          {
            "id": "p-she",
            "text": "She",
            "note": "a girl / a woman",
            "icon": "girl"
          },
          {
            "id": "p-he",
            "text": "He",
            "note": "a boy / a man",
            "icon": "boy"
          }
        ]
      },
      {
        "role": "modal",
        "title": "can → can't",
        "body": "**can** = able to. **can't** = not able to. The **n't** means *not*.",
        "items": [
          {
            "id": "m-can",
            "text": "can",
            "note": "able to",
            "icon": "heart"
          },
          {
            "id": "m-cant",
            "text": "can't",
            "note": "add n't",
            "base": "can",
            "form": "can't",
            "icon": "heart"
          }
        ]
      },
      {
        "role": "verb",
        "title": "Action words",
        "body": "After **can** / **can't**, use the **base** action word (no -s, no -ing).",
