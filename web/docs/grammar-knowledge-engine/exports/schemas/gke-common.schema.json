{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weknowenglish.local/gke/gke-common.schema.json",
  "title": "GKE Common Definitions",
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "grammarL1Id": {
      "type": "string",
      "pattern": "^grammar\\.[a-z][a-z0-9_]*$"
    },
    "grammarL2Id": {
      "type": "string",
      "pattern": "^grammar\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "grammarL3Id": {
      "type": "string",
      "pattern": "^grammar\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "grammarL4Id": {
      "type": "string",
      "pattern": "^grammar\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "errorCode": {
      "type": "string",
      "pattern": "^error\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "cefrLevel": {
      "type": "string",
      "enum": ["A1", "A2", "B1"]
    },
    "yleLevel": {
      "type": "string",
      "enum": ["starters", "movers", "flyers"]
    },
    "learningStrandId": {
      "type": "string",
      "enum": [
        "meaning_focused_input",
        "meaning_focused_output",
        "language_focused_learning",
        "fluency_development"
      ]
    },
    "evidenceMode": {
      "type": "string",
      "enum": ["recognition", "recall", "production", "transfer"]
    },
    "publishStatus": {
      "type": "string",
      "enum": ["published", "draft", "stub", "preview", "optional"]
    },
    "errorSeverity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "localizedLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teacher", "student"],
      "properties": {
        "teacher": { "type": "string", "minLength": 1, "maxLength": 120 },
        "student": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "standardsRefStub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "posterCardRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "cardIndex"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "cardIndex": { "type": "integer", "minimum": 0, "maximum": 9 }
      }
    },
    "recordsEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "records"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "generatedAt": { "$ref": "#/$defs/isoDate" },
        "records": { "type": "array" }
      }
    }
  }
}
