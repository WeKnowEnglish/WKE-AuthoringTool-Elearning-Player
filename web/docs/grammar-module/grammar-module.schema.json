{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weknowenglish.local/grammar-module/grammar-module.schema.json",
  "title": "GrammarModule",
  "description": "Data-driven grammar infographic module for elementary ESL learners.",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleTitle", "pageLayout", "cards"],
  "properties": {
    "moduleTitle": {
      "type": "string",
      "minLength": 1
    },
    "moduleSubtitle": { "type": "string" },
    "displayMode": {
      "type": "string",
      "enum": ["poster", "showcase"],
      "default": "poster",
      "description": "poster = student view; showcase = author layout lab"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Footer hashtags. Omit on student posters (displayMode: poster)."
    },
    "difficulty": {
      "type": "string",
      "enum": ["A1", "A2", "B1"]
    },
    "pageLayout": {
      "type": "string",
      "enum": [
        "single-column",
        "two-equal",
        "two-equal-then-full",
        "four-card-grid-then-split",
        "two-by-two-then-full",
        "custom"
      ]
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "displayMode": { "const": "poster" },
          "difficulty": { "const": "A1" }
        },
        "required": ["displayMode", "difficulty"]
      },
      "then": {
        "properties": {
          "cards": { "maxItems": 3 }
        }
      }
    }
  ],
  "$defs": {
    "themeId": {
      "type": "string",
      "enum": [
        "sky-blue",
        "tangerine",
        "mint-green",
        "sun-gold",
        "lavender",
        "bubblegum"
      ]
    },
    "layoutType": {
      "type": "string",
      "enum": [
        "full-width",
        "two-equal",
        "three-column",
        "full-width-split",
        "four-card-grid",
        "comparison",
        "banner",
        "two-column-positive-negative",
        "summary-grid"
      ]
    },
    "glanceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxLength": 60 },
        "highlight": { "type": "string" }
      }
    },
    "subHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "badge": { "type": "string" },
        "desc": { "type": "string" },
        "extra": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "graphic": { "type": "string" },
        "caption": { "type": "string" },
        "highlight": { "type": "string" },
        "transformationRow": { "$ref": "#/$defs/transformationRow" }
      },
      "anyOf": [
        { "required": ["text"] },
        { "required": ["transformationRow"] }
      ]
    },
    "transformationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "operator", "suffix", "to"],
      "properties": {
        "from": { "type": "string" },
        "operator": { "type": "string" },
        "suffix": { "type": "string" },
        "to": { "type": "string" },
        "graphic": { "type": "string" },
        "ipa": { "type": "string" }
      }
    },
    "miniCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rule"],
      "properties": {
        "title": { "type": "string" },
        "rule": { "type": "string" },
        "formula": { "type": "string" },
        "badge": { "type": "string" },
        "theme": { "$ref": "#/$defs/themeId" }
      }
    },
    "qaSide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "graphic": { "type": "string" },
        "highlight": { "type": "string" }
      }
    },
    "goodBadPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["good", "bad"],
      "properties": {
        "good": { "$ref": "#/$defs/qaSide" },
        "bad": { "$ref": "#/$defs/qaSide" }
      }
    },
    "sidePanel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "example": { "type": "string" },
        "formula": { "type": "string" },
        "warning": { "type": "string" }
      }
    },
    "comparisonSide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "properties": {
        "title": { "type": "string" },
        "badge": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "graphic": { "type": "string" }
            }
          }
        }
      }
    },
    "summaryMark": {
      "type": "string",
      "enum": ["check", "cross", "dash", "text"]
    },
    "summaryCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark"],
      "properties": {
        "mark": { "$ref": "#/$defs/summaryMark" },
        "text": { "type": "string" },
        "graphic": { "type": "string" }
      }
    },
    "summaryGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "properties": {
              "label": { "type": "string" }
            }
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "cells"],
            "properties": {
              "label": { "type": "string" },
              "cells": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/summaryCell" }
              }
            }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "theme", "layoutType"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "kidTitle": {
          "type": "string",
          "maxLength": 40,
          "description": "Short header for student poster; renderer prefers this over title when present"
        },
        "kidSubtitle": {
          "type": "string",
          "maxLength": 30,
          "description": "Secondary kid label, e.g. One thing, Many things"
        },
        "theme": { "$ref": "#/$defs/themeId" },
        "layoutType": { "$ref": "#/$defs/layoutType" },
        "glanceRule": { "$ref": "#/$defs/glanceRule" },
        "subHeader": { "$ref": "#/$defs/subHeader" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        },
        "leftSide": { "$ref": "#/$defs/sidePanel" },
        "rightSide": { "$ref": "#/$defs/sidePanel" },
        "leftColumn": { "$ref": "#/$defs/comparisonSide" },
        "rightColumn": { "$ref": "#/$defs/comparisonSide" },
        "positiveSide": { "$ref": "#/$defs/sidePanel" },
        "negativeSide": { "$ref": "#/$defs/sidePanel" },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "formula"],
            "properties": {
              "label": { "type": "string" },
              "formula": { "type": "string" },
              "graphic": { "type": "string" }
            }
          }
        },
        "bannerText": { "type": "string" },
        "summaryGrid": { "$ref": "#/$defs/summaryGrid" },
        "miniCards": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/miniCard" }
        },
        "goodBadPair": { "$ref": "#/$defs/goodBadPair" }
      }
    }
  }
}
