{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "clean": "node -e \"try { require('fs').rmSync('.next', { recursive: true, force: true }); } catch (e) { if (e.code !== 'ENOENT') throw e; }\"",
    "postinstall": "node ./scripts/ensure-explore-hotspots-react.mjs",
    "build": "next build",
    "build:live-game-ground": "node scripts/build-english-craft-ground.mjs",
    "prebuild": "node ./scripts/check-classroom-realtime-rollout.mjs && node ./scripts/ensure-explore-hotspots-react.mjs && npm run validate:grammar",
    "analyze": "cross-env ANALYZE=true next build",
    "audit:production": "npm audit --omit=dev --audit-level=critical",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:wke-001-live": "node scripts/check-wke-001-live-env.mjs && cross-env WKE_001_LIVE_ACCEPTANCE=true playwright test --config=playwright.wke-001-live.config.ts",
    "provision:wke-001": "tsx scripts/provision-wke-001-fixtures.ts",
    "test:smoke": "node scripts/smoke-production-routes.mjs",
    "test:seo": "node scripts/seo-integration-smoke.mjs",
    "test:seo:unit": "vitest run lib/seo",
    "test:grammar": "vitest run lib/grammar-builder lib/grammar-templates",
    "test:gke": "vitest run lib/gke",
    "validate:grammar": "vitest run lib/grammar-builder lib/grammar-templates && tsx scripts/validate-grammar-content.ts",
    "sync:dog-poses": "node scripts/sync-dog-poses.mjs",
    "create-teacher": "node scripts/create-teacher-user.mjs",
    "media:finalize-metadata": "node scripts/finalize-media-metadata.mjs",
    "assets:import": "node scripts/import-ai-asset-library.mjs",
    "story:unified-dry-run": "vitest run lib/story-unified/story-import-smoke.test.ts lib/story-unified/build-unified-reactions.test.ts",
    "audit:student-copy": "tsx scripts/audit-student-facing-copy.ts",
    "autodetect:letter-fruit": "tsx scripts/autodetect-letter-fruit-bounds.ts",
    "generate:sentence-bank": "node scripts/embed-a1-sentence-bank.mjs",
    "expand:sentence-variants": "node scripts/expand-sentence-variants.mjs",
    "snapshot:quiz-eligibility": "tsx scripts/generate-quiz-eligibility-snapshot.ts",
    "report:secondary-cloze": "tsx scripts/report-secondary-cloze-coverage.ts",
    "audit:secondary-primary-lexicon": "tsx scripts/audit-secondary-primary-lexicon-map.ts",
    "generate:secondary-primary-lexicon-map": "tsx scripts/generate-secondary-primary-lexicon-map.ts",
    "add:secondary-lexicon-gaps": "node scripts/add-secondary-lexicon-gaps-to-dictionary.mjs",
    "prepare:landing-mascots": "tsx scripts/prepare-landing-mascots.ts",
    "voice:keelan-samples": "node scripts/generate-keelan-voice-samples.mjs",
    "voice:keelan-session-1": "node scripts/generate-keelan-session-1-dialogue.mjs",
    "voice:session-2": "node scripts/generate-session-2-dialogue.mjs",
    "voice:session-3": "node scripts/generate-session-3-dialogue.mjs",
    "generate:worksheet": "node scripts/generate-worksheet.mjs",
    "build:primary-vocab-search-index": "node scripts/build-primary-vocabulary-search-index.mjs",
    "supabase:version": "supabase --version",
    "supabase:status": "supabase migration list --linked",
    "supabase:audit": "node scripts/audit-supabase-migration-baseline.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:new": "supabase migration new"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.91.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^3.8.1",
    "@liveblocks/client": "^3.22.0",
    "@liveblocks/node": "^3.22.0",
    "@liveblocks/react": "^3.22.0",
    "@liveblocks/react-tiptap": "^3.22.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@wke/explore-hotspots-author": "file:../packages/explore-hotspots-author",
    "@wke/explore-hotspots-play": "file:../packages/explore-hotspots-play",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "jimp": "^1.6.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.38.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.4",
    "stripe": "^22.6.1",
    "three": "^0.186.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "supabase": "2.116.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
